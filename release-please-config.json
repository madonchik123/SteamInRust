{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "SteamInRust",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "extra-files": [
        { "type": "generic", "path": "Cargo.toml" }
      ],
      "changelog-sections": [
        { "type": "feat", "section": "New" },
        { "type": "fix", "section": "Fixes" },
        { "type": "perf", "section": "Faster" },
        { "type": "i18n", "section": "Translations" },
        { "type": "ui", "section": "Look and feel" },
        { "type": "docs", "section": "Docs", "hidden": true },
        { "type": "chore", "section": "Maintenance", "hidden": true },
        { "type": "ci", "section": "Maintenance", "hidden": true },
        { "type": "refactor", "section": "Maintenance", "hidden": true }
      ]
    }
  }
}
